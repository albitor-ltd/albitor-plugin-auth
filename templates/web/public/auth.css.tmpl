/* The sign-in screens, rendered by the cognito-auth pack. Every colour is a
   token from styles.css, so the contrast it guarantees holds here too. Restyle
   these through the app's design system; keep the data-testid values. */

.auth-screen h1 {
  font-size: 1.5rem;
  margin: 0 0 1.25rem;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  margin-bottom: 1.25rem;
}

.auth-form label {
  font-weight: 600;
  margin-top: 0.6rem;
}

.auth-form input {
  padding: 0.55rem 0.75rem;
  border: 1px solid var(--control-border);
  border-radius: 0.5rem;
  font-size: 1rem;
  background: var(--surface);
  color: var(--fg);
}

.auth-form input:focus {
  outline: 2px solid var(--accent);
  outline-offset: 1px;
}

.auth-form button {
  margin-top: 1rem;
  align-self: flex-start;
  padding: 0.55rem 1rem;
  border: none;
  border-radius: 0.5rem;
  background: var(--accent);
  color: var(--on-accent);
  font-size: 1rem;
  cursor: pointer;
}

.auth-form button:hover {
  background: var(--accent-hover);
}

.auth-form button:disabled {
  cursor: progress;
}

.auth-hint {
  margin: 0;
  color: var(--muted);
  font-size: 0.9rem;
}

.auth-error {
  margin: 0;
  padding: 0.6rem 0.8rem;
  border-radius: 0.5rem;
  background: var(--down-bg);
  color: var(--down);
}

.auth-status {
  margin: 0;
  padding: 0.6rem 0.8rem;
  border-radius: 0.5rem;
  background: var(--ok-bg);
  color: var(--ok);
}

.auth-screen a,
.auth-link {
  color: var(--accent);
}

.auth-link {
  padding: 0;
  border: none;
  background: none;
  font: inherit;
  text-decoration: underline;
  cursor: pointer;
}

.signed-in {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--muted);
  font-size: 0.9rem;
}

/* .auth-form sets display, which would otherwise beat the hidden attribute. */
.auth-form[hidden] {
  display: none;
}
