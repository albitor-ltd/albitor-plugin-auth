package server

import (
	"context"
	"crypto"
	"crypto/rsa"
	"crypto/sha256"
	"encoding/base64"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"math/big"
	"net/http"
	"strings"
	"sync"
	"time"
)

// Verifying a Cognito token, with the standard library only.
//
// Cognito signs every token RS256 with a key from the pool's JWKS. The check is
// the one AWS documents: the signature against the key the token's `kid` names,
// then `iss` (this pool), `token_use` and the client (`aud` on an ID token,
// `client_id` on an access token), then expiry. Anything that fails is refused,
// and the caller is told nothing about why.
//
// It is written out here rather than taken from a JWT library so the API's
// go.mod needs nothing new: RS256 is one hash and one RSA check, and the only
// algorithm accepted. A token naming any other `alg` — "none" included — is
// refused before its claims are read.

var (
	// errTokenInvalid is any token that is not a valid token for this pool and
	// client.
	errTokenInvalid = errors.New("token is not valid")
	// errTokenExpired is a token that WAS valid: correctly signed for this pool
	// and client, and now past its expiry. Only this one may be refreshed.
	errTokenExpired = errors.New("token has expired")
	// errVerifierUnavailable is a token that could not be checked because the
	// pool's keys could not be fetched. It is the platform's failure, not the
	// caller's, so it does not end their session.
	errVerifierUnavailable = errors.New("token keys are unavailable")
)

const (
	// clockSkew is how far a token's iat may sit in the future.
	clockSkew = 2 * time.Minute
	// jwksRefetchInterval bounds how often an unknown kid refetches the JWKS,
	// so a flood of forged kids cannot turn into a flood of fetches.
	jwksRefetchInterval = 5 * time.Minute
	maxJWKSBytes        = 1 << 20
)

// tokenVerifier checks tokens for one pool and client. It is safe for
// concurrent use.
type tokenVerifier struct {
	issuer   string
	clientID string
	jwksURL  string
	client   *http.Client
	now      func() time.Time

	mu        sync.Mutex
	keys      map[string]*rsa.PublicKey
	fetchedAt time.Time
}

func newTokenVerifier(issuer, clientID, jwksURL string, client *http.Client) *tokenVerifier {
	return &tokenVerifier{
		issuer:   issuer,
		clientID: clientID,
		jwksURL:  jwksURL,
		client:   client,
		now:      time.Now,
		keys:     map[string]*rsa.PublicKey{},
	}
}

type tokenHeader struct {
	Alg string `json:"alg"`
	Kid string `json:"kid"`
}

type tokenClaims struct {
	Iss      string `json:"iss"`
	Sub      string `json:"sub"`
	Aud      string `json:"aud"`
	ClientID string `json:"client_id"`
	TokenUse string `json:"token_use"`
	Email    string `json:"email"`
	Exp      int64  `json:"exp"`
	Iat      int64  `json:"iat"`
}

// verify returns the identity a token carries, errTokenExpired for a genuine
// token past its expiry, errVerifierUnavailable when the pool's keys cannot be
// fetched, or errTokenInvalid.
func (v *tokenVerifier) verify(ctx context.Context, raw string) (Identity, error) {
	parts := strings.Split(raw, ".")
	if len(parts) != 3 {
		return Identity{}, errTokenInvalid
	}
	var header tokenHeader
	if err := decodeSegment(parts[0], &header); err != nil || header.Alg != "RS256" || header.Kid == "" {
		return Identity{}, errTokenInvalid
	}
	key, err := v.key(ctx, header.Kid)
	if err != nil {
		return Identity{}, err
	}
	sig, err := base64.RawURLEncoding.DecodeString(parts[2])
	if err != nil {
		return Identity{}, errTokenInvalid
	}
	digest := sha256.Sum256([]byte(parts[0] + "." + parts[1]))
	if rsa.VerifyPKCS1v15(key, crypto.SHA256, digest[:], sig) != nil {
		return Identity{}, errTokenInvalid
	}

	var claims tokenClaims
	if err := decodeSegment(parts[1], &claims); err != nil {
		return Identity{}, errTokenInvalid
	}
	if claims.Iss != v.issuer || claims.Sub == "" {
		return Identity{}, errTokenInvalid
	}
	switch claims.TokenUse {
	case "id":
		if claims.Aud != v.clientID {
			return Identity{}, errTokenInvalid
		}
	case "access":
		if claims.ClientID != v.clientID {
			return Identity{}, errTokenInvalid
		}
	default:
		return Identity{}, errTokenInvalid
	}
	now := v.now()
	if claims.Iat > now.Add(clockSkew).Unix() {
		return Identity{}, errTokenInvalid
	}
	if claims.Exp == 0 || now.Unix() >= claims.Exp {
		return Identity{}, errTokenExpired
	}
	return Identity{Sub: claims.Sub, Email: claims.Email}, nil
}

func decodeSegment(seg string, into any) error {
	b, err := base64.RawURLEncoding.DecodeString(seg)
	if err != nil {
		return err
	}
	return json.Unmarshal(b, into)
}

// key returns the pool's public key for kid, fetching the JWKS when the kid is
// unknown and the last fetch is old enough. A fetch failure is not cached.
func (v *tokenVerifier) key(ctx context.Context, kid string) (*rsa.PublicKey, error) {
	v.mu.Lock()
	defer v.mu.Unlock()
	if k, ok := v.keys[kid]; ok {
		return k, nil
	}
	if !v.fetchedAt.IsZero() && v.now().Sub(v.fetchedAt) < jwksRefetchInterval {
		return nil, errTokenInvalid
	}
	keys, err := v.fetchJWKS(ctx)
	if err != nil {
		return nil, fmt.Errorf("%w: %w", errVerifierUnavailable, err)
	}
	v.keys = keys
	v.fetchedAt = v.now()
	if k, ok := v.keys[kid]; ok {
		return k, nil
	}
	return nil, errTokenInvalid
}

type jwks struct {
	Keys []struct {
		Kid string `json:"kid"`
		Kty string `json:"kty"`
		Alg string `json:"alg"`
		N   string `json:"n"`
		E   string `json:"e"`
	} `json:"keys"`
}

func (v *tokenVerifier) fetchJWKS(ctx context.Context) (map[string]*rsa.PublicKey, error) {
	req, err := http.NewRequestWithContext(ctx, http.MethodGet, v.jwksURL, nil)
	if err != nil {
		return nil, err
	}
	resp, err := v.client.Do(req)
	if err != nil {
		return nil, err
	}
	defer func() { _ = resp.Body.Close() }()
	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("JWKS answered %d", resp.StatusCode)
	}
	body, err := io.ReadAll(io.LimitReader(resp.Body, maxJWKSBytes))
	if err != nil {
		return nil, err
	}
	var set jwks
	if err := json.Unmarshal(body, &set); err != nil {
		return nil, err
	}
	keys := map[string]*rsa.PublicKey{}
	for _, k := range set.Keys {
		if k.Kty != "RSA" || (k.Alg != "" && k.Alg != "RS256") || k.Kid == "" {
			continue
		}
		n, errN := base64.RawURLEncoding.DecodeString(k.N)
		e, errE := base64.RawURLEncoding.DecodeString(k.E)
		if errN != nil || errE != nil || len(e) == 0 || len(e) > 4 {
			continue
		}
		exp := new(big.Int).SetBytes(e)
		keys[k.Kid] = &rsa.PublicKey{N: new(big.Int).SetBytes(n), E: int(exp.Int64())}
	}
	if len(keys) == 0 {
		return nil, errors.New("JWKS holds no RS256 key")
	}
	return keys, nil
}
